# Copy to .env.local (local dev) and fill in — and add the same two values in
# Vercel → Project → Settings → Environment Variables. Never commit the real values.

# Supabase → Project Settings → Data API → Project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Secret key (sb_secret_…)
# (older projects: the "service_role" key, as SUPABASE_SERVICE_ROLE_KEY).
# Server-only: never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx
